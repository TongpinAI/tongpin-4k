+    private static String ordinal(String value) {
+        boolean units = value.indexOf('十') >= 0 || value.indexOf('百') >= 0 || value.indexOf('千') >= 0 || value.indexOf('万') >= 0;
+        if (!units) {
+            StringBuilder digits = new StringBuilder();
