  "narrative": {
    "northStar": "索引片库",
    "overview": "用户确认浅米底、墨蓝文字、蓝色重点与紧凑密度。界面以找片和观看为目的，品牌表达落在清楚的对齐、稳定的标题层级和少量蓝色操作态上。\n\n本文记录手机端 1.3.3 的 Android Views 资源、共享 PhoneUi 与公开片库／播放页代码，采用原生 dp/sp。沿用既有 framework 控件和播放器，没有引入 Material 3 组件库。上游影片封面保留原色；HTML 草图和面板示意不作为 APK 原生渲染证据。",
    "keyCharacteristics": [
      "浅米背景与白色内容区域，墨蓝主文字。",
      "蓝色用于品牌、选中态与明确操作，浅蓝操作面使用墨蓝文字。",
      "紧凑原生列表、影片网格与可辨识的圆角操作。",
      "真实路由、真实服务归属与动态影片内容。"
    ],
    "rules": [
      {
        "name": "One Accent",
        "body": "蓝色承担品牌、选中态和可执行操作；正文、次要信息与分隔线各用自己的颜色角色。",
        "section": "colors"
      },
      {
        "name": "Native Measure",
        "body": "布局与触区使用 dp，文字使用 sp；HTML 面板的像素示意不能替代设备上的原生量测。",
        "section": "typography"
      },
      {
        "name": "Flat Index",
        "body": "普通内容区域以背景、留白和细分隔线区分层级，不为本次界面增加装饰阴影。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用现有 tp 颜色角色与系统 sans／sans-serif 字体。",
      "Do 保留真实路由、控件 ID、绑定 tag、观看进度、手动切源及“我的”隐藏状态。",
      "Do 保持已整理操作至少 48dp 的代码触区，并将原生字体缩放、系统栏和键盘验证列为待验项目。",
      "Do 保留影片原色、动态数据、原始来源和作品署名／许可标注。"
    ],
    "donts": [
      "Don't 把 HTML 草图、面板组件、静态检查或 APK 编译写成原生视觉验收通过。",
      "Don't 新增无实际路由的第三个底部“片库”页面或恢复已隐藏的“我的”功能。",
      "Don't 将来源标签、非空 URL、最大集号或应用名称写成实测 4K、可播性或最快上传保证。",
      "Don't 把沿用原播放核心及接口的 fork 描述为从零重写或同频自有片源服务。"
    ]
  }
}
