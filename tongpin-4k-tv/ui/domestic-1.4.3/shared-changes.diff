+    private static String[] countryParts(String declared, boolean directory) {
+        String value = normalized(declared).replace("people's republic of china", "peoplesrepublicofchina")
+                .replace("people’s republic of china", "peoplesrepublicofchina")
+                .replace("united states of america", "unitedstatesofamerica")
+                .replace("united states", "unitedstates").replace("united kingdom", "unitedkingdom")
+                .replace("mainland china", "mainlandchina").replace("hong kong", "hongkong")
+                .replace("south korea", "southkorea").replace("south africa", "southafrica")
+                .replace("north korea", "northkorea").replace("new zealand", "newzealand").replace("sri lanka", "srilanka");
