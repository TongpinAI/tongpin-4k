+        return value.split("[,，、/|;；&+\\s\\p{Z}]+");
+    }
+    private static boolean extraChineseCountry(String declared, boolean directory) {
+        for (String part : countryParts(declared, directory)) if (oneOf(regionToken(part),
+                "中国|中國|中华人民共和国|中華人民共和國|china|cn|prc|peoplesrepublicofchina|澳门|澳門|中国澳门|中國澳門|macau|macao")) return true;
+        return false;
+    }
+    private static boolean wholeChineseCountry(String declared, boolean directory) {
+        for (String part : countryParts(declared, directory)) if (oneOf(regionToken(part),
+                "中国|中國|中华人民共和国|中華人民共和國|china|cn|prc|peoplesrepublicofchina")) return true;
+        return false;
+    }
+    private static boolean regionalDomestic(RegionEvidence r) {
+        return r.exact.contains(Section.MAINLAND) || r.exact.contains(Section.HONG_KONG)
+                || r.exact.contains(Section.TAIWAN) || r.hkTaiwan;
+    }
+    private static boolean declaredForeignCountry(String declared, boolean directory) {
+        for (String part : countryParts(declared, directory)) {
+            if (extraChineseCountry(part, directory)) continue;
+            RegionEvidence r = regions(part, directory);
+            if (r.western || r.japanKorea || r.otherKnown || r.exact.contains(Section.KOREA)
+                    || r.exact.contains(Section.JAPAN) || r.exact.contains(Section.USA)
+                    || r.exact.contains(Section.UK) || r.exact.contains(Section.THAILAND)) return true;
+        }
+        return false;
+    }
+    private static boolean domestic(Video video) {
+        if (video == null || video.provider == null || CatalogApi.liveProvider(video.provider)) return false;
+        List<String> path = declaredPath(video, null);
+        RegionEvidence directory = directoryRegions(path);
+        if (directory.conflict) return false;
+        boolean pathDomestic = false, pathPureChina = false, pathForeignOnly = false;
+        for (String node : path) {
+            boolean extra = extraChineseCountry(node, true);
+            boolean foreign = declaredForeignCountry(node, true);
+            boolean local = regionalDomestic(regions(node, true)) || extra;
+            pathDomestic |= local; pathPureChina |= extra && !foreign; pathForeignOnly |= foreign && !local;
+        }
+        if (pathPureChina && pathForeignOnly) return false;
+        if (text(video.area).trim().isEmpty()) return pathDomestic
+                && !(directory.foreign && !regionalDomestic(directory) && pathPureChina);
+        RegionEvidence area = regions(video.area, false);
+        boolean areaExtra = extraChineseCountry(video.area, false);
+        boolean areaForeign = declaredForeignCountry(video.area, false);
+        boolean areaDomestic = regionalDomestic(area) || areaExtra;
+        if (!areaDomestic || !compatible(area, directory)
+                && !(wholeChineseCountry(video.area, false) && regionalDomestic(directory))) return false;
+        if (areaExtra && !areaForeign && (pathForeignOnly || directory.foreign && !regionalDomestic(directory))) return false;
+        return true;
     }
 
